# MiniMax TTS 配置
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会提交）
#   cp .env.example .env
# 使用前加载：
#   set -a && source .env && set +a

# 开放平台 API Key（账户管理 > 接口密钥）
MINIMAX_API_KEY=

# 克隆音色 ID。还没有的话先跑：
#   python3 minimax_tts.py --clone 1_ref.wav --clone-id alexinsights01
MINIMAX_VOICE_ID=

# 可选：模型版本，默认 speech-2.8-hd
# MINIMAX_MODEL=speech-2.8-hd

# 可选：国际站改为 https://api.minimax.io/v1
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
